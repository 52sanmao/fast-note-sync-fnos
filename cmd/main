#!/bin/bash
#
# fastnotesync lifecycle controller.
# Manages the fast-note-sync-service binary (start/stop/status).
#
# The binary is a self-contained Go service (frontend embedded) that
# auto-generates config/config.yaml with a random auth token on first run.
# Working directory is set to TRIM_PKGVAR so config, database and uploads
# persist across restarts and survive upgrades.

set -u

APPNAME="${TRIM_APPNAME:-fastnotesync}"
BIN_NAME="fast-note-sync-service"
BIN_PATH="${TRIM_APPDEST}/${BIN_NAME}"

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# Persistent working directory for the service (config + storage live here).
WORK_DIR="${TRIM_PKGVAR}"

# Service configuration file (auto-generated by the binary on first run).
CONFIG_FILE="${WORK_DIR}/config/config.yaml"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

is_running() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Read the HTTP port currently configured in config.yaml ("127.0.0.1:9000"
# or ":9000" -> 9000). The file is the single source of truth: the wizard
# writes it, this script never rewrites it, so a port chosen in the app
# settings survives reboots and upgrades.
config_port() {
  [ -f "$CONFIG_FILE" ] || return 0
  sed -n 's/^[[:space:]]*http-port:[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "$CONFIG_FILE" \
    | head -n 1 | sed 's/^.*://'
}

is_valid_port() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Keep the desktop entry's port in sync with config.yaml (ui/config is plain
# JSON the app center reads when launching the icon). Needed because a port
# changed in the app settings would otherwise leave the entry pointing at the
# old one, and because every upgrade replaces ui/config with the packaged copy.
sync_entry_port() {
  local entry="${TRIM_APPDEST}/ui/config" port
  [ -f "$entry" ] || return 0

  port="$(config_port)"
  [ -n "$port" ] || port="${TRIM_SERVICE_PORT:-9000}"
  is_valid_port "$port" || port="9000"

  grep -q "\"port\": \"${port}\"" "$entry" && return 0

  if sed -i "s|\"port\": *\"[^\"]*\"|\"port\": \"${port}\"|" "$entry" 2>>"$LOG_FILE"; then
    log_msg "Desktop entry port set to ${port}."
  else
    log_msg "WARN: could not update ${entry}; the desktop icon keeps its packaged port."
  fi
  return 0
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    if is_running "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    log_msg "Already running (pid $(head -n 1 "$PID_FILE" 2>/dev/null))."
    return 0
  fi

  if [ ! -x "$BIN_PATH" ]; then
    echo "Binary not found or not executable: $BIN_PATH" > "$TRIM_TEMP_LOGFILE"
    log_msg "ERROR: binary missing: $BIN_PATH"
    return 1
  fi

  mkdir -p "$WORK_DIR"

  log_msg "Starting $APPNAME (work_dir=$WORK_DIR, port=$(config_port | grep . || echo default))..."
  # -d sets the working directory; the service auto-creates config/config.yaml
  # there (with a random auth-token-key) on first run.
  cd "$WORK_DIR" || { echo "Cannot enter $WORK_DIR" > "$TRIM_TEMP_LOGFILE"; return 1; }
  "$BIN_PATH" run -d "$WORK_DIR" >> "$LOG_FILE" 2>&1 &
  local pid=$!
  echo "$pid" > "$PID_FILE"
  log_msg "Started, pid=$pid."

  # Give it a moment to bind the port; fail fast if it died immediately.
  sleep 1
  if ! is_running "$pid"; then
    echo "Service exited immediately. See $LOG_FILE." > "$TRIM_TEMP_LOGFILE"
    log_msg "ERROR: process $pid exited immediately."
    rm -f "$PID_FILE"
    return 1
  fi
  return 0
}

stop_app() {
  log_msg "Stopping $APPNAME..."

  if [ ! -f "$PID_FILE" ]; then
    log_msg "No PID file, nothing to stop."
    return 0
  fi

  local pid
  pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"

  if [ -z "$pid" ] || ! is_running "$pid"; then
    rm -f "$PID_FILE"
    log_msg "Process not running, cleaned PID file."
    return 0
  fi

  kill -TERM "$pid" 2>>"$LOG_FILE" || true

  local count=0
  while is_running "$pid" && [ "$count" -lt 15 ]; do
    sleep 1
    count=$((count + 1))
  done

  if is_running "$pid"; then
    log_msg "Process did not exit on TERM, sending KILL."
    kill -KILL "$pid" 2>>"$LOG_FILE" || true
  fi

  rm -f "$PID_FILE"
  log_msg "Stopped."
  return 0
}

case "${1:-}" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  restart)
    stop_app
    start_app
    ;;
  sync-entry)
    sync_entry_port
    ;;
  *)
    echo "Unknown command: ${1:-} (expected start|stop|status|restart|sync-entry)" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
