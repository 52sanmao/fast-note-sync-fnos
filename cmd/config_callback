#!/bin/bash
#
# Runs after an app-setting change is applied.
#
# fast-note-sync-service reads config/config.yaml only at startup (there is no
# file watcher), so a port change has to be written into the file and then
# followed by a restart - otherwise the desktop entry would point at the new
# port while the service still listens on the old one.
set -u

CONFIG_FILE="${TRIM_PKGVAR}/config/config.yaml"
MAIN="${TRIM_APPDEST}/cmd/main"
LOG_FILE="${TRIM_PKGVAR}/app.log"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

is_valid_port() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

PORT="${wizard_port:-}"
if ! is_valid_port "$PORT"; then
  log_msg "Settings change ignored: '${PORT}' is not a valid port."
  exit 0
fi

if [ ! -f "$CONFIG_FILE" ]; then
  log_msg "Settings change: ${CONFIG_FILE} does not exist yet, nothing to rewrite."
  exit 0
fi

CURRENT="$(sed -n 's/^[[:space:]]*http-port:[[:space:]]*"\?\([^"]*\)"\?[[:space:]]*$/\1/p' "$CONFIG_FILE" | head -n 1)"
if [ "$CURRENT" = ":$PORT" ]; then
  log_msg "Settings change: port is already :$PORT, no restart needed."
  exit 0
fi

TMP="$(mktemp "${CONFIG_FILE}.XXXXXX")" || exit 1
if sed "s|^\([[:space:]]*http-port:[[:space:]]*\).*$|\1\":${PORT}\"|" "$CONFIG_FILE" > "$TMP"; then
  # Write in place so owner and mode of config.yaml are kept.
  cat "$TMP" > "$CONFIG_FILE"
  rm -f "$TMP"
else
  rm -f "$TMP"
  log_msg "Settings change failed: could not rewrite http-port."
  exit 1
fi

log_msg "Settings change: http-port set to :$PORT, restarting service."
# The desktop entry carries the port as plain text; repoint it before the
# service comes back on the new port.
"$MAIN" sync-entry
"$MAIN" restart
exit $?
