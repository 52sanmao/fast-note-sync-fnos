#!/bin/bash
# Runs before uninstall. Stop the service so the binary can be released.
#
# Application data lives in TRIM_PKGVAR (-> /vol*/@appdata/{appname}) and is
# NOT removed by the system during uninstall. wizard/uninstall asks the user
# whether to keep or delete it, and cmd/uninstall_callback applies that
# choice. Do not delete data here: the user has not been asked yet.
set -u
if [ -f "${TRIM_PKGVAR}/app.pid" ]; then
  pid="$(head -n 1 "${TRIM_PKGVAR}/app.pid" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    sleep 2
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "${TRIM_PKGVAR}/app.pid"
fi
exit 0
