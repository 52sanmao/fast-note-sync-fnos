appname="fastnotesync"
version="3.6.5"
display_name="Fast Note Sync"
desc="把 Obsidian 的笔记同步搬进自己的 NAS：电脑、手机、平板之间的笔记与附件实时双向同步，每次改动都留有历史版本可回溯。自带 Web 管理面板，管理笔记库、授权令牌、成员权限、备份与存储；提供 REST API 与原生 MCP，脚本和 AI 客户端可直接读写。数据只存在你的 NAS 上，不经第三方云。本应用完全免费，无内购、无功能限制。"
maintainer="52sanmao"
maintainer_url="https://github.com/52sanmao/fast-note-sync-fnos"
distributor="haierkeys"
distributor_url="https://github.com/haierkeys/fast-note-sync-service"
source="thirdparty"
platform="x86"
ctl_stop=true
service_port="9000"
checkport=false
disable_authorization_path=true
os_min_version="1.1.3100"
desktop_uidir="ui"
desktop_applaunchname="fastnotesync.main"
changelog="新增「应用设置 → 运行设置 → 高级设置」里的服务端口配置，改端口后自动重启生效；重写应用介绍；补充外网访问与内网穿透说明。"
